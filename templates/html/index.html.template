<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Singleton SD Assets - {{VERSION}}</title>
    <meta
      name="description"
      content="Binary brand assets for Singleton SD — icon mark, wordmarks, favicons, PWA manifests, and Open Graph images."
    />
    <meta property="og:title" content="Singleton SD Assets {{VERSION}}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://assets.singletonsd.com/" />
    <meta
      property="og:image"
      content="https://assets.singletonsd.com/og-image/light/og-default.jpg"
    />
    <meta name="theme-color" content="#c89200" />
    <link rel="preconnect" href="https://tokens.design.singletonsd.com" />
    <!-- Theme sheets only: root/light would win over [data-theme=dark] and freeze light tokens. -->
    <link href="https://tokens.design.singletonsd.com/css/light/_variables.css" rel="stylesheet" />
    <link href="https://tokens.design.singletonsd.com/css/dark/_variables.css" rel="stylesheet" />
    <link rel="manifest" href="./favicons/circle/bg-none/site.webmanifest" />
    <link rel="apple-touch-icon" href="./favicons/circle/bg-none/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="./favicons/circle/bg-none/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="./favicons/circle/bg-none/favicon-16x16.png"
    />
    <link rel="shortcut icon" href="./favicons/circle/bg-none/favicon.png" />
    <script>
      const urlParams = new URLSearchParams(window.location.search);
      const theme = urlParams.get('theme');
      if (theme === 'dark' || theme === 'light') {
        document.documentElement.setAttribute('data-theme', theme);
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
      window.addEventListener('message', (event) => {
        if (event.data?.theme === 'dark' || event.data?.theme === 'light') {
          document.documentElement.setAttribute('data-theme', event.data.theme);
        }
      });
    </script>
    <style>
      @font-face {
        font-family: 'Open Sauce One';
        src:
          local('Open Sauce One'),
          url('https://fonts.cdnfonts.com/s/88496/OpenSauceOne-Regular.woff') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Open Sauce One';
        src:
          local('Open Sauce One Bold'),
          url('https://fonts.cdnfonts.com/s/88496/OpenSauceOne-Bold.woff') format('woff');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        color-scheme: light;
      }

      html[data-theme='dark'] {
        color-scheme: dark;
      }

      body {
        margin: 0;
        font-family: var(--ssd-font-family-body), 'Open Sauce One', system-ui, sans-serif;
        font-weight: var(--ssd-font-weight-regular);
        font-size: var(--ssd-font-size-300);
        line-height: var(--ssd-line-height-body);
        color: var(--ssd-color-text-default);
        background: var(--ssd-color-background-default);
      }

      img {
        max-width: 100%;
        height: auto;
        vertical-align: middle;
      }

      a {
        color: var(--ssd-color-text-link);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }

      a:hover {
        color: var(--ssd-color-background-brand-hovered);
      }

      .site-bar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--ssd-space-200) var(--ssd-space-300);
        padding: var(--ssd-space-200) var(--ssd-space-400);
        background: var(--ssd-color-background-default);
        border-bottom: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
      }

      .site-brand {
        display: flex;
        align-items: center;
        gap: var(--ssd-space-200);
        color: var(--ssd-color-text-default);
        text-decoration: none;
        font-weight: var(--ssd-font-weight-semibold);
        letter-spacing: var(--ssd-letter-spacing-heading);
      }

      .site-brand:hover {
        color: var(--ssd-color-text-default);
      }

      .site-brand__mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 0;
      }

      .site-brand__logo {
        width: 28px;
        height: 28px;
        display: none;
      }

      html[data-theme='light'] .site-brand__logo--light {
        display: block;
      }

      html[data-theme='dark'] .site-brand__logo--dark {
        display: block;
      }

      .site-brand__version {
        color: var(--ssd-color-text-default);
        font-family: var(--ssd-font-family-mono);
        font-size: var(--ssd-font-size-100);
        font-weight: var(--ssd-font-weight-regular);
      }

      .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ssd-space-200) var(--ssd-space-300);
        margin-left: auto;
        font-size: var(--ssd-font-size-200);
      }

      .site-nav a {
        color: var(--ssd-color-text-link);
        text-decoration: none;
      }

      .site-nav a:hover {
        color: var(--ssd-color-text-default);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .theme-toggle {
        appearance: none;
        margin: 0;
        padding: 4px 12px;
        border: var(--ssd-border-width-default) solid var(--ssd-color-border-brand);
        border-radius: var(--ssd-radius-full);
        background: transparent;
        color: var(--ssd-color-text-link);
        font: inherit;
        font-size: var(--ssd-font-size-100);
        letter-spacing: var(--ssd-letter-spacing-heading);
        cursor: pointer;
      }

      .theme-toggle:hover {
        background: var(--ssd-color-background-brand);
        color: var(--ssd-color-text-on-brand);
      }

      .page {
        max-width: 960px;
        margin: 0 auto;
        padding: var(--ssd-space-500) var(--ssd-space-400) var(--ssd-space-800);
      }

      .page > h1:first-child {
        margin: 0 0 var(--ssd-space-300);
        font-size: var(--ssd-font-size-500);
        font-weight: var(--ssd-font-weight-bold);
        letter-spacing: var(--ssd-letter-spacing-heading);
        line-height: var(--ssd-line-height-heading);
      }

      .page > h1:first-child + p {
        max-width: 40rem;
        margin-bottom: var(--ssd-space-400);
      }

      .page h2 {
        margin: var(--ssd-space-600) 0 var(--ssd-space-300);
        padding-bottom: var(--ssd-space-200);
        border-bottom: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        font-size: var(--ssd-font-size-400);
        font-weight: var(--ssd-font-weight-bold);
        letter-spacing: var(--ssd-letter-spacing-heading);
        line-height: var(--ssd-line-height-heading);
        scroll-margin-top: 72px;
      }

      .page h3,
      .page h4 {
        margin: var(--ssd-space-500) 0 var(--ssd-space-200);
        font-size: var(--ssd-font-size-300);
        font-weight: var(--ssd-font-weight-semibold);
        letter-spacing: var(--ssd-letter-spacing-heading);
        scroll-margin-top: 72px;
      }

      .page p,
      .page ul,
      .page ol {
        margin: 0 0 var(--ssd-space-300);
      }

      .page li + li {
        margin-top: var(--ssd-space-100);
      }

      hr {
        border: none;
        border-top: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        margin: var(--ssd-space-500) 0;
      }

      :not(pre) > code {
        padding: 0.1em 0.4em;
        border: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        border-radius: var(--ssd-radius-sm);
        background: var(--ssd-color-background-muted);
        color: var(--ssd-color-text-default);
        font-family: var(--ssd-font-family-mono);
        font-size: 0.85em;
      }

      pre {
        margin: 0 0 var(--ssd-space-400);
        padding: var(--ssd-space-300);
        overflow-x: auto;
        border: var(--ssd-border-width-default) solid var(--ssd-color-border-default);
        border-radius: var(--ssd-radius-md);
        background: var(--ssd-color-background-muted);
        color: var(--ssd-color-text-default);
        font-family: var(--ssd-font-family-mono);
        font-size: var(--ssd-font-size-200);
        line-height: var(--ssd-line-height-body);
      }

      pre code {
        padding: 0;
        border: none;
        background: none;
        color: inherit;
        font-size: inherit;
      }

      .glance-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: var(--ssd-space-300);
        margin: var(--ssd-space-400) 0;
      }

      .glance-card {
        display: flex;
        flex-direction: column;
        gap: var(--ssd-space-200);
        min-width: 0;
        padding: var(--ssd-space-300);
        border: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        border-radius: var(--ssd-radius-lg);
        background: var(--ssd-color-background-muted);
      }

      .glance-card__preview {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 120px;
      }

      .glance-card__preview a {
        display: flex;
        width: 100%;
        justify-content: center;
        text-decoration: none;
      }

      .glance-card__preview .preview-well {
        width: 100%;
      }

      .glance-card__label {
        font-weight: var(--ssd-font-weight-semibold);
      }

      .glance-card__downloads {
        display: flex;
        flex-wrap: wrap;
        gap: var(--ssd-space-100);
        align-items: center;
      }

      .preview-well {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: var(--ssd-space-200);
        border: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        border-radius: var(--ssd-radius-md);
        line-height: 0;
      }

      .preview-well img {
        display: block;
      }

      .preview-well.is-on-dark {
        background: var(--ssd-color-black);
        border-color: var(--ssd-color-gray-800);
      }

      .preview-well.is-on-muted {
        background: var(--ssd-color-gray-100);
      }

      html[data-theme='dark'] .preview-well.is-on-muted {
        background: var(--ssd-color-gray-800);
      }

      .preview-well.is-on-checker {
        background-color: var(--ssd-color-white);
        background-image:
          linear-gradient(45deg, var(--ssd-color-gray-200) 25%, transparent 25%),
          linear-gradient(-45deg, var(--ssd-color-gray-200) 25%, transparent 25%),
          linear-gradient(45deg, transparent 75%, var(--ssd-color-gray-200) 75%),
          linear-gradient(-45deg, transparent 75%, var(--ssd-color-gray-200) 75%);
        background-size: 16px 16px;
        background-position:
          0 0,
          0 8px,
          8px -8px,
          -8px 0;
      }

      .preview-well.is-mark img {
        width: 80px;
        height: 80px;
      }

      .glance-card .preview-well.is-mark img {
        width: 96px;
        height: 96px;
      }

      .preview-well.is-favicon img {
        width: 64px;
        height: 64px;
      }

      .glance-card .preview-well.is-favicon img {
        width: 80px;
        height: 80px;
      }

      .preview-well.is-wordmark {
        width: min(100%, 360px);
        padding: var(--ssd-space-300);
      }

      .preview-well.is-wordmark img {
        width: 100%;
        max-height: 56px;
        object-fit: contain;
      }

      .preview-well.is-og {
        width: min(100%, 360px);
        padding: 0;
        overflow: hidden;
        background: none;
      }

      .preview-well.is-og img {
        width: 100%;
        height: auto;
      }

      a:has(> .preview-well) {
        text-decoration: none;
      }

      a.file-chip {
        display: inline-flex;
        align-items: center;
        padding: 2px 10px;
        border: var(--ssd-border-width-default) solid var(--ssd-color-border-brand);
        border-radius: var(--ssd-radius-full);
        background: var(--ssd-color-background-default);
        color: var(--ssd-color-text-link);
        text-decoration: none;
        font-family: var(--ssd-font-family-mono);
        font-size: var(--ssd-font-size-100);
        line-height: 1.6;
      }

      a.file-chip:hover {
        background: var(--ssd-color-background-brand);
        border-color: var(--ssd-color-background-brand);
        color: var(--ssd-color-text-on-brand);
      }

      .asset-table {
        width: 100%;
        margin: 0 0 var(--ssd-space-400);
        border-collapse: collapse;
        font-size: var(--ssd-font-size-200);
      }

      .asset-table thead th {
        padding: var(--ssd-space-200) var(--ssd-space-300);
        border-bottom: var(--ssd-border-width-strong) solid var(--ssd-color-border-brand);
        text-align: left;
        font-weight: var(--ssd-font-weight-semibold);
        letter-spacing: var(--ssd-letter-spacing-heading);
      }

      .asset-table td:first-child {
        white-space: nowrap;
      }

      .asset-table tbody td {
        padding: var(--ssd-space-300);
        border-bottom: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        vertical-align: middle;
      }

      .asset-table tbody tr:hover {
        background: var(--ssd-color-background-muted);
      }

      .asset-table td:has(.preview-well) {
        text-align: center;
      }

      .asset-table-wrap {
        overflow-x: auto;
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--ssd-space-400);
        padding: var(--ssd-space-400);
        background: var(--ssd-color-background-default);
        border-top: var(--ssd-border-width-default) solid var(--ssd-color-border-muted);
        color: var(--ssd-color-text-default);
        font-size: var(--ssd-font-size-200);
      }

      footer a {
        display: flex;
        align-items: center;
        gap: var(--ssd-space-200);
        color: var(--ssd-color-text-default);
        text-decoration: none;
      }

      footer a:hover {
        color: var(--ssd-color-text-default);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      footer svg {
        width: 16px;
        height: 16px;
      }

      @media (max-width: 720px) {
        .site-nav {
          order: 3;
          flex-basis: 100%;
          margin-left: 0;
        }

        .asset-table td:first-child {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-bar">
      <a class="site-brand" href="./">
        <span class="site-brand__mark" aria-hidden="true">
          <img
            class="site-brand__logo site-brand__logo--light"
            src="./logo/static/light/circle/bg-none/512.png"
            alt=""
            width="28"
            height="28"
          />
          <img
            class="site-brand__logo site-brand__logo--dark"
            src="./logo/static/dark/circle/bg-none/512.png"
            alt=""
            width="28"
            height="28"
          />
        </span>
        <span>Assets</span>
        <span class="site-brand__version">{{VERSION}}</span>
      </a>
      <nav class="site-nav" aria-label="Sections">
{{NAV}}
      </nav>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false">Dark</button>
    </header>
    <main class="page">
{{CONTENT}}
    </main>
{{FOOTER}}
    <script>
      (function () {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (!button) return;

        const apply = (next) => {
          root.setAttribute('data-theme', next);
          button.textContent = next === 'dark' ? 'Light' : 'Dark';
          button.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
          if (themeColor) {
            themeColor.setAttribute('content', next === 'dark' ? '#000000' : '#c89200');
          }
        };

        apply(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
        button.addEventListener('click', function () {
          apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });
      })();
    </script>
  </body>
</html>
